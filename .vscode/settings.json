{
	// Workbench settings
	"workbench.list.smoothScrolling": true,
	// "workbench.colorTheme": "Bearded Theme Arc",
	"workbench.colorTheme": "poimandres-noitalics",
	"workbench.iconTheme": "symbols",
	"workbench.tree.indent": 9,
	"workbench.layoutControl.enabled": false,

	// Editor settings
	"editor.fontFamily": "Dank Mono",
	"editor.fontSize": 16,
	"editor.lineHeight": 2,
	"editor.fontLigatures": true,
	"editor.wordWrap": "on",
	"editor.suggestSelection": "first",
	"editor.tabSize": 2,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.inlineSuggest.enabled": true,
	"editor.codeActionsOnSave": {
		// "source.organizeImports": "explicit",
		"source.fixAll.eslint": "always"
	},
	"editor.minimap.enabled": false,
	"editor.smoothScrolling": true,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.accessibilitySupport": "off",
	"editor.cursorBlinking": "expand",
	"editor.cursorStyle": "line",

	"window.commandCenter": true,
	"window.autoDetectColorScheme": false,
	"terminal.integrated.smoothScrolling": true,
	"terminal.integrated.defaultProfile.osx": "zsh",

	"search.exclude": {
		"**/.git": true,
		"**/node_modules": true,
},

	// Cursor settings
	"cursor.composer.textSizeScale": 0.85,
	"cursor.composer.queueMessageDefaultBehavior": "stop-and-send",
	"cursor.composer.usageSummaryDisplay": "always",

	// Extensions settings
	"prettier.useTabs": true,
	"prettier.requireConfig": true,

	"symbols.hidesExplorerArrows": false,

	"js/ts.updateImportsOnFileMove.enabled": "always",

	"git.confirmSync": false,
	"git.openRepositoryInParentFolders": "always",
	
	"gitlens.views.branches.showStashes": true,
	"gitlens.advanced.messages": {
		"suppressCreatePullRequestPrompt": true
	},
}
