{
	// Workbench settings
	"workbench.list.smoothScrolling": true,
	"workbench.iconTheme": "symbols",
  // "workbench.colorTheme": "Cursor Dark Midnight",
	"workbench.colorTheme": "Bearded Theme Arc",
	"workbench.tree.indent": 9,
	"workbench.layoutControl.enabled": false,

	// Editor settings
	"editor.fontFamily": "Dank Mono",
	"editor.fontSize": 16,
	"editor.lineHeight": 1.7,
	"editor.fontLigatures": true,
	"editor.wordWrap": "on",
	"editor.suggestSelection": "first",
	"editor.tabSize": 2,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.formatOnSave": true,
	"editor.inlineSuggest.enabled": true,
	"editor.codeActionsOnSave": {
		// "source.organizeImports": "explicit",
		"source.fixAll.eslint": "always"
	},
	"editor.minimap.enabled": false,
	"editor.smoothScrolling": true,
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.accessibilitySupport": "off",
	"editor.cursorBlinking": "expand",
	"editor.cursorStyle": "line",

	"window.commandCenter": true,
	"terminal.integrated.smoothScrolling": true,

	"search.exclude": {
		"**/.git": true,
		"**/node_modules": true,
},

	// Cursor settings
	"cursor.cpp.disabledLanguages": [
		"markdown",
		"plaintext"
	],
	"cursor.composer.textSizeScale": 0.85,
	"cursor.composer.queueMessageDefaultBehavior": "stop-and-send",

	// VScode settings
	// "github.copilot.editor.enableAutoCompletions": true,

	// Extensions settings
	"prettier.useTabs": true,
	"prettier.requireConfig": true,

	"symbols.hidesExplorerArrows": false,

	"typescript.updateImportsOnFileMove.enabled": "always",
	"javascript.updateImportsOnFileMove.enabled": "always",

	"git.confirmSync": false,
	"git.openRepositoryInParentFolders": "always",
	"gitlens.views.branches.showStashes": true,

	"gitlens.advanced.messages": {
		"suppressCreatePullRequestPrompt": true
	},
	"gitlens.views.scm.grouped.views": {
		"commits": true,
		"branches": false,
		"remotes": true,
		"stashes": true,
		"tags": false,
		"worktrees": true,
		"contributors": true,
		"repositories": false,
		"searchAndCompare": false,
		"launchpad": false
	},
}
