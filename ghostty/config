theme = Matte Black
font-size = 14
window-height=40
window-width=160
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-icon = glass
split-divider-color = #222
unfocused-split-opacity = 1
cursor-style = block
cursor-style-blink = true
cursor-color = #818181
shell-integration-features = no-cursor
background-opacity = 1
background-blur = 16

# Neutralize Matte Black's yellow/amber green and blue slots.
palette = 2=#bbbbbb
palette = 10=#eeeeee
palette = 3=#bbbbbb
palette = 11=#eeeeee
palette = 4=#bbbbbb
palette = 12=#eeeeee